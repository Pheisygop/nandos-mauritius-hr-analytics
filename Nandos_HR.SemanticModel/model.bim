                "    Blanks = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"EmployeeID\", type text}, {\"Branch\", type text}, {\"Role\", type text}, {\"Department\", type text}, {\"ReportsToRole\", type text}, {\"Gender\", type text}, {\"HireDate\", type date}, {\"ExitDate\", type date}, {\"ExitReason\", type text}, {\"ExitType\", type text}, {\"ContractType\", type text}, {\"EmploymentType\", type text}, {\"FTEFactor\", type number}, {\"BaseMonthlySalaryMUR\", type number}, {\"BrandAmbassador\", Int64.Type}, {\"AmbassadorArea\", type text}}, \"en-US\")",
