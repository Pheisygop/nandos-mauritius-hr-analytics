        "lineageTag": "ca902993-7cd3-46da-b82d-8ca2f5259348",
        "measures": [
          {
            "name": "Closing Headcount",
            "displayFolder": "HR Measures",
            "expression": [
              "VAR M = MAX ( 'Calendar'[MonthStart] )",
              "RETURN CALCULATE ( SUM ( HRMonthly[ClosingHeadcount] ), REMOVEFILTERS ( 'Calendar' ), TREATAS ( { M }, HRMonthly[MonthStart] ) )"
            ],
            "formatString": "#,##0",
            "lineageTag": "b72f8801-65eb-4fe0-a880-bf3675312777"
          },
          {
            "name": "Opening Headcount",
            "displayFolder": "HR Measures",
            "expression": [
              "VAR M = MIN ( 'Calendar'[MonthStart] )",
              "RETURN CALCULATE ( SUM ( HRMonthly[OpeningHeadcount] ), REMOVEFILTERS ( 'Calendar' ), TREATAS ( { M }, HRMonthly[MonthStart] ) )"
            ],
            "formatString": "#,##0",
            "lineageTag": "c7b64a6b-f641-4409-89ec-a62f83ea7eeb"
          },
          {
            "name": "Total Hires",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[Hires] )",
            "formatString": "#,##0",
            "lineageTag": "2b845a60-02b0-4457-9cb5-22c5b54341d3"
          },
          {
            "name": "Total Exits",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[Exits] )",
            "formatString": "#,##0",
            "lineageTag": "71fb2fc9-ebfa-4e3d-b230-6b4be26b9f84"
          },
          {
            "name": "Voluntary Exits",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[VoluntaryExits] )",
            "formatString": "#,##0",
            "lineageTag": "2af20bcd-7da3-401f-ada2-4d3cf9fe8ea9"
          },
          {
            "name": "Average Headcount",
            "displayFolder": "HR Measures",
            "expression": [
              "AVERAGEX (",
              "    VALUES ( 'Calendar'[MonthStart] ),",
              "    CALCULATE ( DIVIDE ( SUM ( HRMonthly[OpeningHeadcount] ) + SUM ( HRMonthly[ClosingHeadcount] ), 2 ) )",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "6a2c0bfe-4852-46bf-80db-8e216a311035"
          },
          {
            "name": "Turnover Rate",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Total Exits], [Average Headcount] )",
            "formatString": "0.0%",
            "lineageTag": "3663b66f-1a66-4d3f-b08e-55a9fcf6466a"
          },
          {
            "name": "Voluntary Turnover Rate",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Voluntary Exits], [Average Headcount] )",
            "formatString": "0.0%",
            "lineageTag": "0c162a48-f711-4d91-85ed-e6805fd0d138"
          },
          {
            "name": "Headcount Reconciliation",
            "displayFolder": "HR Measures",
            "expression": "[Opening Headcount] + [Total Hires] - [Total Exits] - [Closing Headcount]",
            "formatString": "#,##0",
            "lineageTag": "c7261c05-1917-477e-a0d5-0afd9a41220f"
          },
          {
            "name": "Scheduled Days",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[ScheduledDays] )",
            "formatString": "#,##0",
            "lineageTag": "b95b2547-f099-4a4d-bcb1-4666ba6db7ad"
          },
          {
            "name": "Worked Days",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[WorkedDays] )",
            "formatString": "#,##0",
            "lineageTag": "f3fa2c8d-b063-4511-8956-e1c89ce949f3"
          },
          {
            "name": "Absent Days",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[AbsentDays] )",
            "formatString": "#,##0",
            "lineageTag": "916082ff-e441-4084-919c-5f7ce0f9b443"
          },
          {
            "name": "Paid Leave Days",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[PaidLeaveDays] )",
            "formatString": "#,##0",
            "lineageTag": "7d59deee-a9db-40fa-b920-171db8ad0c9a"
          },
          {
            "name": "Absence Rate",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Absent Days], [Scheduled Days] )",
            "formatString": "0.0%",
            "lineageTag": "7f9c51a8-84dc-4274-8907-79db6d3e091b"
          },
          {
            "name": "Attendance Rate",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Worked Days], [Scheduled Days] )",
            "formatString": "0.0%",
            "lineageTag": "03e73480-2ceb-4625-9b3a-dcd5e02cea61"
          },
          {
            "name": "Overtime Hours",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[OvertimeHours] )",
            "formatString": "#,##0.0",
            "lineageTag": "7506373b-f12f-458f-99a4-570b7d1c81a1"
          },
          {
            "name": "Basic Pay MUR",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[BasicPayMUR] )",
            "formatString": "\"Rs \"#,##0.00",
            "lineageTag": "c99ab4c0-2329-4cc2-9477-6f740015378d"
          },
          {
            "name": "Absence Deduction MUR",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[AbsenceDeductionMUR] )",
            "formatString": "\"Rs \"#,##0.00",
            "lineageTag": "6dba5343-3e03-4a84-931a-f279c1a96c60"
          },
          {
            "name": "Overtime Pay MUR",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[OvertimePayMUR] )",
            "formatString": "\"Rs \"#,##0.00",
            "lineageTag": "2292d59d-a24c-42ca-bfdf-6e51a49b63c0"
          },
          {
            "name": "Gross Pay MUR",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[GrossPayMUR] )",
            "formatString": "\"Rs \"#,##0.00",
            "lineageTag": "31f7655f-dfa5-42a0-819b-d14cba362496"
          },
          {
            "name": "Payroll Reconciliation MUR",
            "displayFolder": "HR Measures",
            "expression": "[Gross Pay MUR] - [Basic Pay MUR] + [Absence Deduction MUR] - [Overtime Pay MUR]",
            "formatString": "\"Rs \"#,##0.00",
            "lineageTag": "fce7c8de-bb47-44bc-9fc4-f647f16390cb"
          },
          {
            "name": "Employee Months",
            "displayFolder": "HR Measures",
            "expression": "COUNTROWS ( HRMonthly )",
            "formatString": "#,##0",
            "lineageTag": "80bacdc1-f7c0-40cf-b374-1a1a0cbb60ad"
          },
          {
            "name": "Average Pay per Employee Month MUR",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Gross Pay MUR], [Employee Months] )",
            "formatString": "\"Rs \"#,##0.00",
            "lineageTag": "241366d2-10db-41cf-8c2c-9d8c72b1a011"
          },
          {
            "name": "Overtime Share of Pay",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Overtime Pay MUR], [Gross Pay MUR] )",
            "formatString": "0.0%",
            "lineageTag": "33728c9d-7396-4201-a3ab-c7862442b523"
          },
          {
            "name": "Training Assigned",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[TrainingAssigned] )",
            "formatString": "#,##0",
            "lineageTag": "431b5e34-e66b-4f61-9078-69f63c018eea"
          },
          {
            "name": "Training Completed",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[TrainingCompleted] )",
            "formatString": "#,##0",
            "lineageTag": "b6ab1d9c-bb6c-4b49-8e77-ba5b6de85360"
          },
          {
            "name": "Training Completion Rate",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Training Completed], [Training Assigned] )",
            "formatString": "0.0%",
            "lineageTag": "24573eed-51bf-4c6a-8648-acf5fc3e33d7"
          },
          {
            "name": "Training Hours",
            "displayFolder": "HR Measures",
            "expression": "SUM ( HRMonthly[TrainingHours] )",
            "formatString": "#,##0.0",
            "lineageTag": "fc6bb3a0-9ad7-4f75-8141-711881e69b7b"
          },
          {
            "name": "Average Engagement",
            "displayFolder": "HR Measures",
            "expression": "AVERAGE ( HRMonthly[EngagementScore] )",
            "formatString": "0.00",
            "lineageTag": "af70f085-1256-417d-aaed-bc50f47c62be"
          },
          {
            "name": "Female Closing Headcount",
            "displayFolder": "HR Measures",
            "expression": "CALCULATE ( [Closing Headcount], Employees[Gender] = \"Female\" )",
            "formatString": "#,##0",
            "lineageTag": "03909840-67cb-4d22-a4da-d3f38877ef23"
          },
          {
            "name": "Female Representation",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Female Closing Headcount], [Closing Headcount] )",
            "formatString": "0.0%",
            "lineageTag": "3630363a-764d-4051-aa8f-9c8a8883024d"
          },
          {
            "name": "Net Headcount Change",
            "displayFolder": "HR Measures",
            "expression": "[Total Hires] - [Total Exits]",
            "formatString": "#,##0",
            "lineageTag": "d1ab18cd-af36-43f4-9d73-ec91f8d86533"
          },
          {
            "name": "Closing FTE",
            "displayFolder": "HR Measures",
            "expression": [
              "VAR M = MAX ( 'Calendar'[MonthStart] )",
              "RETURN CALCULATE ( SUM ( HRMonthly[ClosingFTE] ), REMOVEFILTERS ( 'Calendar' ), TREATAS ( { M }, HRMonthly[MonthStart] ) )"
            ],
            "formatString": "#,##0.0",
            "lineageTag": "3e3469fe-e16c-4a1f-ad41-93a3467c6b39"
          },
          {
            "name": "Target Headcount",
            "displayFolder": "HR Measures",
            "expression": "SUM ( StaffingTargets[TargetHeadcount] )",
            "formatString": "#,##0",
            "lineageTag": "0817f341-a487-4d1e-bc50-b40706372436"
          },
          {
            "name": "Unfilled Posts",
            "displayFolder": "HR Measures",
            "expression": [
              "SUMX (",
              "    CROSSJOIN ( VALUES ( Branches[Branch] ), VALUES ( Roles[Role] ) ),",
              "    MAX ( 0, CALCULATE ( [Target Headcount] ) - CALCULATE ( [Closing Headcount] ) )",
              ")"
            ],
            "formatString": "#,##0",
            "lineageTag": "169bb873-808d-4d8b-b882-931d8dee50c7"
          },
          {
            "name": "Part Time Closing Headcount",
            "displayFolder": "HR Measures",
            "expression": "CALCULATE ( [Closing Headcount], Employees[EmploymentType] = \"Part time\" )",
            "formatString": "#,##0",
            "lineageTag": "aeda3500-240f-40ba-9733-7a6f4dee3430"
          },
          {
            "name": "Staffing Coverage",
            "displayFolder": "HR Measures",
            "expression": "DIVIDE ( [Closing Headcount], [Target Headcount] )",
            "formatString": "0.0%",
            "lineageTag": "2c007ed3-f1fc-4797-9eac-3e72b99f058f"
          },
          {
            "name": "Brand Ambassador Headcount",
            "displayFolder": "HR Measures",
            "expression": "CALCULATE ( [Closing Headcount], Employees[BrandAmbassador] = 1 )",
            "formatString": "#,##0",
            "lineageTag": "714f88fb-073d-40ef-852b-6540c885e450"
          },
          {
            "name": "BOH Brand Ambassadors",
            "displayFolder": "HR Measures",
            "expression": "CALCULATE ( [Brand Ambassador Headcount], Employees[AmbassadorArea] = \"Back of House\" )",
            "formatString": "#,##0",
            "lineageTag": "b7a64c4f-de71-4e34-9a29-133ccdb8c881"
          },
          {
            "name": "FOH Brand Ambassadors",
            "displayFolder": "HR Measures",
            "expression": "CALCULATE ( [Brand Ambassador Headcount], Employees[AmbassadorArea] = \"Front of House\" )",
            "formatString": "#,##0",
            "lineageTag": "0b34de7a-b3dc-45c9-9a10-f582f31bc3ce"
          }
        ],
